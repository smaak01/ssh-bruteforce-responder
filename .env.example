# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://www.abuseipdb.com/account/api (optional: enables IP reputation lookups)
ABUSEIPDB_API_KEY=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# (optional: enables alerts)
DISCORD_WEBHOOK_URL=
